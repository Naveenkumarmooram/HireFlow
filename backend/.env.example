# Local development only. Copy to .env, generate secrets, then run migrate.py and app.bootstrap.
ENVIRONMENT=development
DATABASE_URL=sqlite+pysqlite:///./hireflow.db
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_MINUTES=30
AUTO_MIGRATE_ON_STARTUP=false
BOOTSTRAP_ORG_NAME=Your organisation
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
RESUME_ENCRYPTION_KEY=
CLAMD_HOST=
CLAMD_PORT=3310
