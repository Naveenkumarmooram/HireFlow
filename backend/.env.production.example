# Set runtime values privately in the Vercel API project. Never commit real values.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
JWT_SECRET=
CORS_ORIGINS=https://YOUR-FRONTEND.vercel.app
ACCESS_TOKEN_MINUTES=30
AUTO_MIGRATE_ON_STARTUP=false
# Optional: uploads remain disabled until both scanning and encryption are configured.
RESUME_ENCRYPTION_KEY=
CLAMD_HOST=
CLAMD_PORT=3310
# Set these locally ONLY for the one-time python -m app.bootstrap command.
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
